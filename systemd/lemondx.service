# User service (recommended): install-service.sh copies this to
# ~/.config/systemd/user/lemondx.service and fills in @LEMONDX_PATH@.
#
# Runs as the invoking user, which is what lemondx wants: it needs that
# user's membership in the `lxd`/`incus-admin` group to reach the daemon
# socket, reads that user's ~/.ssh/*.pub for the SSH-key picker, and keeps
# its state under that user's ~/.local/share/lemondx. A system service
# running as a separate account would need all three set up by hand for an
# account that has no login shell to set them up with.
#
# Manage with `systemctl --user`, not `systemctl`. Logs: `journalctl --user
# -u lemondx -f`. Runs at boot without a graphical login only after
# `loginctl enable-linger $USER` (install-service.sh prints this reminder when needed).

[Unit]
Description=lemondx - web UI and API for local LXD/Incus containers
Documentation=https://github.com/
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 @LEMONDX_PATH@/lemondx serve
# Starts in unconfigured mode -- 127.0.0.1:8099, no login, plain HTTP -- until
# Configure node in the UI (or `lemondx configure node` as this user, then a
# restart) adds an admin login, HTTPS and the address to listen on. Pressing
# it restarts the server in place, under the same PID. No --host/--port here:
# a flag would override the saved address. Flags appended here (--auth local,
# --token-file PATH, ...) override saved settings. --auth pam also needs the
# NoNewPrivileges change noted below; see docs/service.md#authentication.
# Unbuffered, or the startup warnings (a fabric that cannot program
# routes, PAM that cannot work) sit in a block buffer and never reach
# the journal, which is where they are meant to be read.
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# lemondx is stdlib-only and touches nothing outside its own state
# directory, the daemon socket, and (for bootstrap) ~/.ssh/*.pub -- so it
# costs little to also ask systemd to enforce that.
# --auth pam: set this to "no". PAM's unix_chkpwd helper reads /etc/shadow
# through a setgid bit, which this disables, and every login would fail.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/lemondx
PrivateTmp=yes

[Install]
WantedBy=default.target
