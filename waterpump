#!/usr/bin/env python3
"""Run waterpump straight from a checkout, with nothing installed.

realpath() so the script still finds the package when it is reached through a
symlink on PATH (ln -s ~/dev/waterpump/waterpump ~/.local/bin/waterpump).
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "src"))

from waterpump.cli import main

if __name__ == "__main__":
    sys.exit(main())
